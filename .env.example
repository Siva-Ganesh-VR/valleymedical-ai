# Copy to .env (for Docker) and backend/.env (for local runs). Never commit or share the real file.

# ---- AI model -------------------------------------------------------------------------------
# gemini (default) | anthropic | mock. With no key for the chosen provider, the offline mock is used.
VM_LLM_PROVIDER=gemini
GEMINI_API_KEY=
VM_GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
VM_ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Rate limit ------------------------------------------------------------------------------
# Model calls per minute across the whole app. Set it just under your key's limit (see the provider
# console) to avoid "429 Too Many Requests". 0 disables throttling.
VM_LLM_REQUESTS_PER_MINUTE=10

# ---- AI gateway: budget and cost estimate ---------------------------------------------------
# Monthly token budget across all workflows. When used up, AI calls are blocked and work goes to
# the exception queue. Set to 0 to disable.
VM_LLM_MONTHLY_TOKEN_BUDGET=5000000
# Optional: USD per million tokens, from your provider's price page, to show estimated cost.
# VM_LLM_PRICE_INPUT_PER_MTOK=
# VM_LLM_PRICE_OUTPUT_PER_MTOK=

# ---- Demo ----------------------------------------------------------------------------------
# Fixes "today" so the synthetic claims behave the same in every demo. Remove for real dates.
VM_AS_OF_DATE=2026-09-01
