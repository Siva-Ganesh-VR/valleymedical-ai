# Copy to .env (for Docker) and backend/.env (for local runs).

# Leave empty to run with the offline mock model (no API calls).
ANTHROPIC_API_KEY=

# auto = Claude when a key is set, otherwise mock. Or force: anthropic | mock
VM_LLM_PROVIDER=auto
VM_ANTHROPIC_MODEL=claude-sonnet-5-5

# Fixes "today" so the synthetic claims behave the same in every demo. Remove for real dates.
VM_AS_OF_DATE=2026-09-01
